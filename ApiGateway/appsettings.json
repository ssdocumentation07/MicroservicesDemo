{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Key": "ThisIsMySuperSecretJwtKeyForZomatoApplication2026@123",
    "Issuer": "ZomatoAPI",
    "Audience": "ZomatoClient"
  },
  "ReverseProxy": {
    "Routes": {
      "order-route": {
        "ClusterId": "order-cluster",
        "AuthorizationPolicy": "AdminOnly",
        "Match": {
          "Path": "/api/orders/{**catch-all}"
        }
      },

      "inventory-route": {
        "ClusterId": "inventory-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/inventory/{**catch-all}"
        }
      },

      "payment-route": {
        "ClusterId": "payment-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/payment/{**catch-all}"
        }
      }
    },

    "Clusters": {
      "order-cluster": {
        "Destinations": {
          "order-service": {
            "Address": "https://localhost:7159/"
          }
        }
      },

      "inventory-cluster": {
        "Destinations": {
          "inventory-service": {
            "Address": "https://localhost:7148/"
          }
        }
      },

      "payment-cluster": {
        "Destinations": {
          "payment-service": {
            "Address": "https://localhost:7234/"
          }
        }
      }
    }
  }

}
